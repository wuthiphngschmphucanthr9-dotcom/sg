-- STREAMING_CHUNK:Setting up player role viewing and ESP system...
local RoleESPEnabled = false
local function GetPlayerRole(player)
if not player or not player.Character then return "Innocent", Color3.fromRGB(100, 255, 100) end
local char = player.Character
local backpack = player:FindFirstChild("Backpack")
-- เช็คการถือปืน หรือมีด
local hasKnife = (char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife")) or char:FindFirstChild("Blade"))
local hasGun = (char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun")) or char:FindFirstChild("Revolver"))
if hasKnife then
return "Murderer 🔪", Color3.fromRGB(255, 50, 50)
elseif hasGun then
return "Sheriff 🔫", Color3.fromRGB(50, 150, 255)
end
-- เช็คจากค่า Value ในตัวผู้เล่น (ถ้ามี)
if player:FindFirstChild("Role") then
return tostring(player.Role.Value), Color3.fromRGB(255, 255, 255)
end
return "Innocent 😇", Color3.fromRGB(100, 255, 100)
end
local function UpdateRoleESP()
for _, player in ipairs(Players:GetPlayers()) do
if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
local head = player.Character.Head
local existingTag = head:FindFirstChild("RoleTagESP")
if RoleESPEnabled then
local roleName, color = GetPlayerRole(player)
if not existingTag then
local bb = Instance.new("BillboardGui")
bb.Name = "RoleTagESP"
bb.Adornee = head
bb.Size = UDim2.new(0, 120, 0, 40)
bb.StudsOffset = Vector3.new(0, 2.5, 0)
bb.AlwaysOnTop = true
local txt = Instance.new("TextLabel")
txt.Name = "RoleLabel"
txt.Size = UDim2.new(1, 0, 1, 0)
txt.BackgroundTransparency = 1
txt.Text = player.DisplayName .. "\n[" .. roleName .. "]"
txt.TextColor3 = color
txt.TextStrokeTransparency = 0.2
txt.TextSize = 14
txt.Font = Enum.Font.SourceSansBold
txt.Parent = bb
bb.Parent = head
else
local roleName, color = GetPlayerRole(player)
existingTag.RoleLabel.Text = player.DisplayName .. "\n[" .. roleName .. "]"
existingTag.RoleLabel.TextColor3 = color
end
else
if existingTag then
existingTag:Destroy()
end
end
end
end
end
